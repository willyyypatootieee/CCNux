{
    "app-id": "com.ccnux.creativecloudnux",
    "runtime": "org.gnome.Platform",
    "runtime-version": "47",
    "sdk": "org.gnome.Sdk",
    "command": "ccnux",
    "finish-args": [
        "--share=ipc",
        "--socket=fallback-x11",
        "--socket=wayland",
        "--share=network",
        "--device=dri",
        "--filesystem=host",
        "--filesystem=xdg-documents",
        "--filesystem=xdg-videos",
        "--filesystem=xdg-download",
        "--talk-name=org.freedesktop.Notifications",
        "--env=PATH=/app/bin:/usr/bin"
    ],
    "modules": [
        {
            "name": "ccnux",
            "buildsystem": "meson",
            "sources": [
                {
                    "type": "dir",
                    "path": "../.."
                }
            ]
        }
    ]
}
